NEXT_PUBLIC_APP_NAME="GoldDemo"
NEXT_PUBLIC_APP_TAGLINE="Goldsmith Accounting System"
NEXT_PUBLIC_APP_LOGO="/demo-logo.svg"
VITE_API_BASE_URL="https://gold-demo-api.example"
# Reserved for future Supabase browser integrations; current UI uses the Express API.
NEXT_PUBLIC_SUPABASE_URL="https://<demo-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<demo-publishable-or-legacy-anon-key>"

# In the demo Vercel project, set both API variables to the actual new backend.
# This blocks builds and startup if the demo is configured to use another API.
VITE_DEMO_API_ORIGIN="https://gold-demo-api.example"
